# Baixe os valores com: npx vercel env pull .env.local --environment=development
# Nunca commite .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Texto aleatório usado para anonimizar IPs (sha256(ip + sal)).
IP_HASH_SALT=
# E-mail de aprovação (Brevo): chave da API e remetente verificado no Brevo.
BREVO_API_KEY=
EMAIL_REMETENTE=
# O projeto NÃO usa SUPABASE_SERVICE_ROLE_KEY: tudo passa pelas regras do banco (RLS).
